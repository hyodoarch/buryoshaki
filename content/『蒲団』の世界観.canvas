		{"id":"a9cbab9c680d62af","type":"text","text":"芳子、牛込矢来町の時雄宅へ戻る","x":-205,"y":724,"width":178,"height":92},
		{"id":"67b5790595c2671f","type":"text","text":"芳子、田中とはキレイな関係であることを誓う","x":-245,"y":398,"width":240,"height":93},
