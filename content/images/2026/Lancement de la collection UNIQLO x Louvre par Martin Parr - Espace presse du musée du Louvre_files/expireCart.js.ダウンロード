function datediff(date1, date2){
    var diff = {}                           // Initialisation du retour
    var tmp = date2 - date1;

    tmp = Math.floor(tmp/1000);             // Nombre de secondes entre les 2 dates
    diff.sec = tmp % 60;                    // Extraction du nombre de secondes

    tmp = Math.floor((tmp-diff.sec)/60);    // Nombre de minutes (partie entière)
    diff.min = tmp % 60;                    // Extraction du nombre de minutes

    tmp = Math.floor((tmp-diff.min)/60);    // Nombre d'heures (entières)
    diff.hour = tmp % 24;                   // Extraction du nombre d'heures

    tmp = Math.floor((tmp-diff.hour)/24);   // Nombre de jours restants
    diff.day = tmp;

    return diff;
}


function cleartcartfromdate(){
    var cart_key = getallkeyscart();
    if (cart_key.length > 0) {
        var cartExpire = getcontentcart('cart_expires');
        var ifExpire = localStorage.getItem('cart_expires');
    }
    if (ifExpire) {
        if (cart_key.length > 0) {
            var d = new Date();
            var year = d.getFullYear();
            var month = d.getMonth()+1;
            var day = d.getDate();

            var d_expires = new Date(cartExpire * 1000);
            var year_expires = d_expires.getFullYear();
            var month_expires = d_expires.getMonth()+1;
            var day_expires = d_expires.getDate();
            var today_date = day + '/' + month + '/' + year;
            var expires_date = day_expires + '/' + month_expires + '/' + year_expires;
            var check_expires_cart = returnverifyfunction(today_date, expires_date);

            if (check_expires_cart === -1) {
                jQuery.each(cart_key, function(index, value) {
                    localStorage.setItem(value, JSON.stringify([]));
                });
                clearcart();
            }
            else
                return check_expires_cart;
        }
    } else {
        jQuery.each(cart_key, function(index, value) {
            localStorage.setItem(value, JSON.stringify([]));
        });
        clearcart();
    }
}

function deleteimgcard() {
    var tableinlocalstorage = getallkeyscart();
    if (tableinlocalstorage) {
        for (let i = 0; i < tableinlocalstorage.length ; i++) {
            var cartLS = localStorage.getItem(tableinlocalstorage[i]);
            let array = JSON.parse(cartLS);
            var request = jQuery.post({
                method: "POST",
                url: ajaxurlCartExpire,
                data: {
                    'action': 'checkIfAssetExist',
                    'id': array
                }
            });
            request.done(function (response) {
                var parseReponse =  JSON.parse(response);
                if (parseReponse.todelete) {
                    for (let j = 0; j < parseReponse.todelete.length ; j++) {
                        if (array) {
                            var positionarray = array.indexOf(parseReponse.todelete[j]);

                            if (positionarray !== -1) {
                                array = jQuery.grep(array, function(value) {
                                    return value != array[positionarray];
                                });
                                localStorage.setItem(tableinlocalstorage[i], JSON.stringify(array));
                            }
                        }
                    }
                }
            });
        }
    }
}

