function getcontentcart(param) {
    var cartLS = localStorage.getItem(param),
        cart = [];
    if (cartLS)
        cart = JSON.parse(cartLS);
    return cart;
}

function getallkeyscart() {
    var cart_key = [];
    for (var i = 0, len = localStorage.length; i < len; ++i) {
        var key = localStorage.key[i];
        if (key) {
            if (key.indexOf('cart') !== -1) {
                if (key !== 'cart_expires')
                    cart_key.push(key);
            }
        }

    }
    return cart_key;
}

function clearcart() {
    var durationcart = document.querySelector('.durationcart');
    if (durationcart)
        durationcart.style.display = "none";
    var cart_key = getallkeyscart();
    if (cart_key.length > 0) {
        localStorage.setItem('cart_expires', "");
    }
    jQuery('#listImgCartDropdown.en').html('<div class="alert_msg marg15" role="alert">Your bag is empty, please select an attachment</div>');
