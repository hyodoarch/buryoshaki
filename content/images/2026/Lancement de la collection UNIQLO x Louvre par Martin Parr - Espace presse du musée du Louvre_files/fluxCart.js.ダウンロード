function loadCounter() {
  const mycartLS = getSelectedCart('cart_selection_louvre');
  jQuery('#countImg, .badge-selection').html(mycartLS.length);
}

function getUrlDownloadPicture(id) {
  const cart = getSelectedCart('cart_selection_louvre');
  const { origin } = window.location;
  const url = `${origin}/download/?zip=2&pictures=`;

  if (id) {
    var finalUrl = url + id;
    window.open(finalUrl, '_blank');
  } else if (cart.length === 0) {
  } else {
    let idsString = '';
    const selectedItems = jQuery('.selected-items');
    // All selected elements
    if (selectedItems.length > 0) {
      for (const i in selectedItems) {
        var id = jQuery(selectedItems[i]).attr('data-id');
        idsString += id;
        if (i !== selectedItems.length - 1) {
          idsString += '-';
        }
      }
    } else {
      // The entire array
      idsString = cart.join('-');
    }
    var finalUrl = url + idsString;
    window.open(finalUrl, '_blank');
  }
  return false;
}

jQuery('body').on('click', '.addImageToCart', function (e) {
  e.preventDefault();
  const self = jQuery(this);
  const id = self.attr('data-id');

  if (id) {
    if (self.hasClass('added')) {
      deleteItemInCart(id, 'cart_selection_louvre');
      self.removeClass('added');
      self.children('i').removeClass('fas').addClass('fal');
    } else {
      setItemInCart(id, 'cart_selection_louvre');
      self.addClass('added');
      self.children('i').removeClass('fal').addClass('fas');
    }
  }

  loadCounter();
});

jQuery('body').on('click', '.imgDelete', function () {
  const self = jQuery(this);
  const id = self.attr('data-id');

  if (id) {
    deleteItemInCart(id, 'cart_selection_louvre');

    self
      .parent()
      .parent()
      .parent('.thumbnail-wrapper')
      .fadeOut(500, function () {
        jQuery(this).remove();
      });

    loadCounter();
  }

  const mycart = getSelectedCart('cart_selection_louvre');

  if (mycart.length == 0) {
    appendNoData();
  }
});

function loadHTML() {
  const cart = getSelectedCart('cart_selection_louvre');
  if (cart) {
    const request = $.ajax({
      method: 'POST',
      url: ajaxurlCart,
      data: {
        action: 'add_html_to_cart',
        items: cart,
      },
    });

    request.done((response) => {
      if (response !== '') {
        jQuery('#listImgCart').html(response);
      }
    });
  }
}

function deleteAllItems(param) {
  // delete all items
  jQuery(document).on('click', '#confirmClearCart', () => {
    localStorage.setItem(param, []);
    appendNoData();
    jQuery('#cart .badge-counter').hide();
    jQuery('#confirm_deletion').fadeOut(150);
  });
}

function appendNoData() {
  // If no item append no data text
  const mycartLS = getSelectedCart('cart_selection_louvre');
  console.log(mycartLS.length);
  if (mycartLS.length < 1) {
    jQuery('#listImgCart').html(
      '<div class="alert alert-warning marg15" role="alert">Your bag is empty, please select an attachment</div>',
    );
    jQuery('.cartLoad, .modal-header').css('display', 'none');
    jQuery('#countImg, .badge-selection').text('0');
    jQuery('.addImageToCart').children('i').removeClass('fa-check-square').addClass('fa-square');
  }
}

function downloadCart() {
  jQuery('#downloadSelection, #downloadSelectionSingle').click(function (e) {
    e.preventDefault();
    const self = jQuery(this);
    const urlToDownload = getUrlDownloadPicture();

    self.attr('href', urlToDownload);
  });
  return true;
}

function checkifChecked() {
  const cart_selected = getSelectedCart('cart_selection_louvre');

  jQuery(document).ajaxComplete(() => {
    for (const item in cart_selected) {
      const checkbox = jQuery(`[data-id='${cart_selected[item]}']`);

      if (checkbox.hasClass('addImageToCart')) {
        checkbox.addClass('added');
        checkbox.children().removeClass('fal').addClass('fas');
      }
    }
  });
}

function sendEmail() {
  jQuery(document).on('click', '#sendEmail', function () {
    path_domain = window.location.origin;
    const idsStringImg = getSelectedCart('cart_selection_louvre');
    const resultImg = idsStringImg.join('-');
    let textSelection;

    if (jQuery(this).hasClass('fr')) {
      textSelection += 'Veuillez trouver via ce lien les visuels sélectionnés:%0D%0A';
    } else {
      textSelection += 'Please find here a link to the visuals selected:%0D%0A';
    }

    const body = `${textSelection}\r\n\r\n${path_domain}/download/?zip=2&opt=cart&pictures=${resultImg}`;

    const emailFriendlyUrl = `mailto:?body=${encodeURIComponent(body)}`;
    jQuery(this).attr('href', emailFriendlyUrl);
  });
}

/** ********************
 *
 * @Page Search Download Selection
 */

function getSelectedCart(param) {
  const cartLS = localStorage.getItem(param);
  let cart = [];

  if (cartLS) {
    cart = JSON.parse(cartLS);
  }

  return cart;
}

function deleteItemInCart(item_id, param) {
  const cart = getSelectedCart(param);

  const index = cart.indexOf(item_id);
  if (index !== -1) {
    cart.splice(index, 1);
  }

  loadCounter();
  localStorage.setItem(param, JSON.stringify(cart));
}

function setItemInCart(item_id, param) {
  const cart = getSelectedCart(param);

  const index = cart.indexOf(item_id);
  if (index === -1) {
    // The item's ID does not exist, so we add it.
    cart.push(item_id);
  }

  loadCounter();
  localStorage.setItem(param, JSON.stringify(cart));
}

jQuery(document).on('click', '#dllSelection-search', function () {
  const cart = getSelectedCart('cart_selection_louvre');
  const cart_joined = cart.join('-');
  const path_domain = window.location.origin;
  const dll_url = `${path_domain}/download/?zip=2&n=Selection &pictures=${cart_joined}`;

  jQuery(this).attr('href', dll_url);
});

jQuery(document).ready(() => {
  $('body').on('click', '#openConfirmClearCart', (e) => {
    e.preventDefault();
    $('#confirm_deletion').fadeIn(150);
    jQuery('.addImageToCart').each(function () {
      jQuery(this).removeClass('added');
    });
    jQuery(document).ajaxComplete(() => {
      const mycartLS = getSelectedCart('cart_selection_louvre');
      if (mycartLS.length < 1) {
        jQuery('#listImgCart').html(
          '<div class="alert alert-warning marg15" role="alert">Your bag is empty, please select an attachment</div>',
        );
        jQuery('.cartLoad, .modal-header').css('display', 'none');
        jQuery('#countImg, .badge-selection').text('0');
        jQuery('.addImageToCart').children('i').removeClass('fa-check-square').addClass('fa-square');
      } else {
        jQuery('.cartLoad, .modal-header').css('display', 'flex');
      }
    });
  });

  $('body').on('click', '#confirm_deletion .bg-overlay, #confirmNotToClearCart', (e) => {
    e.preventDefault();

    $('#confirm_deletion').fadeOut(150);
  });
});

jQuery(document).ready(($) => {
  downloadCart();
  loadCounter();
  deleteAllItems('cart_selection_louvre');
  checkifChecked();
  sendEmail();

