    $('.modal').fadeOut(150);
    $('body').removeClass('no-scroll');
  });

  $('body').on('click', '#cart', (e) => {
    e.preventDefault();
    $('.modal').fadeOut(150);
    $('body').addClass('no-scroll');
    $('aside#myCart').fadeIn(150);

    loadHTML();
    downloadCart();
    loadCounter();
    deleteAllItems('cart_selection_louvre');
    sendEmail();
    jQuery(document).ajaxComplete(() => {
      const mycartLS = getSelectedCart('cart_selection_louvre');
      if (mycartLS.length < 1) {
        jQuery('#listImgCart.en').html(
          '<div class="alert alert-warning marg15" role="alert">Your selection is empty, please select an attachment</div>',
        );
        jQuery('#listImgCart.fr').html(
          '<div class="alert alert-warning marg15" role="alert">Votre sélection est vide, veuillez sélectionner une pièce jointe</div>',
        );
        jQuery('.cartLoad, .modal-header').css('display', 'none');
        jQuery('#countImg, .badge-selection').text('0');
        jQuery('.addImageToCart').children('i').removeClass('fa-check-square').addClass('fa-square');
      } else {
        jQuery('.cartLoad, .modal-header').css('display', 'block');
      }
    });
  });
});
