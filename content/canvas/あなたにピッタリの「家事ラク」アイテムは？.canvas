			"width":213,
			"height":60
		},
		{
			"id":"abc19152c7e73782",
			"type":"text",
			"text":"食品類は、1週間以上のまとめ買いはしない",
			"styleAttributes":{"textAlign":"center"},
			"x":-51,
			"y":-407,
			"width":178,
			"height":118
		},
		{
			"id":"a316d4b441693e15",
			"type":"text",
			"text":"玄関に靴や傘、ベビーカーなどを出しておきたくない",
