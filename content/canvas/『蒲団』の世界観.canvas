	"nodes":[
		{"id":"6db64c421cb2d3cd","type":"group","x":-372,"y":-632,"width":552,"height":2919,"color":"4","label":"蒲団世界"},
		{"id":"3313b5f240552102","type":"group","x":20,"y":-860,"width":400,"height":3697,"color":"5","label":"文学世界"},
		{"id":"b74ea5e47c099417","type":"group","x":-703,"y":-760,"width":423,"height":3486,"color":"2","label":"現実世界"},
		{"id":"2e1a9500a0dc3a1d","type":"text","text":"芳子、「神戸の女学院」に通う。ハイカラで自由な生活","x":-245,"y":-603,"width":220,"height":120,"color":"5"},
		{"id":"67b5790595c2671f","type":"text","text":"芳子、田中とはキレイな関係であることを誓う","x":-241,"y":625,"width":240,"height":93,"color":"5"},
		{"id":"a9cbab9c680d62af","type":"text","text":"芳子、牛込矢来町の時雄宅へ戻る","x":-213,"y":891,"width":178,"height":92,"color":"5"},
		{"id":"b7078fb6c81d7b89","type":"text","text":"死よりも強し／モーパッサン\n若さが徐々に消えていく一方で、欲望や情熱は老いていかない","x":118,"y":1047,"width":283,"height":163,"color":"3"},
		{"id":"5a259c0ace7f9925","type":"text","text":"時雄、悶える","x":-140,"y":537,"width":186,"height":50,"color":"#f078f0"},
		{"id":"43cf005a59d9fd44","type":"text","text":"美知代、神戸女学院に在籍","x":-487,"y":-606,"width":160,"height":80},
		{"id":"1aa55fe62bf80ae9","type":"text","text":"佐々城信子","x":-687,"y":-717,"width":135,"height":62},
		{"id":"84dbb160f9341458","type":"text","text":"田中、最初の上京","x":-210,"y":763,"width":178,"height":65,"color":"5"},
		{"id":"45d2513c439260e1","type":"text","text":"時雄、妻との生活に孤独を感じている。","x":-9,"y":-450,"width":171,"height":114,"color":"#f078f0"},
		{"id":"4f1e971e6c07cd36","type":"text","text":"芳子、時雄に入門。牛込の時雄宅へ仮寓","x":-258,"y":-283,"width":197,"height":88,"color":"5"},
		{"id":"a44eba629de06420","type":"text","text":"一年半の歳月が流れる。\n\n芳子、時雄に「新しい女」の教育を受ける。","x":-234,"y":27,"width":230,"height":159,"color":"5"},
		{"id":"73d32d3fa9260f96","type":"text","text":"1904年、美知代、入門。牛込の花袋宅へ","x":-557,"y":-256,"width":233,"height":106},
		{"id":"33ccaf488132a72a","type":"text","text":"美知代、三番町の姉の家へ転居。津田英学塾予科へ通学。麹町にあった。","x":-528,"y":-84,"width":190,"height":159},
		{"id":"369b81a2aec522fb","type":"text","text":"田中、2回目の上京。東京に居つく","x":-203,"y":1022,"width":188,"height":79,"color":"5"},
		{"id":"e5531075df4814bf","type":"text","text":"時雄 叫ぶ\n“Superfluous man!”","x":127,"y":566,"width":220,"height":110,"color":"#f078f0"},
		{"id":"0939a5485513dfe7","type":"text","text":"その前夜／ツルゲーネフ\n芳子、エレネに自分自身を重ねる","x":155,"y":788,"width":228,"height":133,"color":"3"},
		{"id":"25c0107ecc165795","type":"text","text":"芳子、三番町の姉の家へ転居。麹町の某女塾へ通学","x":-245,"y":-131,"width":213,"height":115,"color":"5"},
		{"id":"39cc41fd5ee0f6b1","type":"text","text":"芳子、時雄に書簡を送り入門を懇願","x":-244,"y":-443,"width":180,"height":100,"color":"5"},
		{"id":"f074cb0dbc4eeab6","type":"text","text":"1905年7月、美知代、関西学院で開催されたYMCA夏期学校で永代と親しくなる","x":-642,"y":154,"width":260,"height":140},
		{"id":"616f7702bbceb619","type":"text","text":"1906年1月、美知代、父に連れられ、上下町へ帰郷。","x":-610,"y":1053,"width":260,"height":100},
		{"id":"7792a4f779f89ada","type":"text","text":"美知代、永代と膳所遊覧","x":-505,"y":359,"width":160,"height":122},
		{"id":"089e6e3718eaaa5e","type":"text","text":"時雄、師弟の関係を超えることを夢想する","x":-133,"y":237,"width":188,"height":122,"color":"#f078f0"},
		{"id":"dd3851c588b1091e","type":"text","text":"芳子、同志社の学生・田中と嵯峨に遊ぶ","x":-251,"y":380,"width":214,"height":103,"color":"5"},
		{"id":"ace6feb889086476","type":"text","text":"時雄、自分の年齢を自覚する","x":-119,"y":1149,"width":178,"height":80,"color":"#f078f0"},
		{"id":"bca3179da219ecd0","type":"text","text":"美知代、牛込の花袋宅へ戻される。","x":-542,"y":821,"width":206,"height":104},
		{"id":"7f47e95cbeb8ad97","type":"text","text":"永代、上京","x":-486,"y":636,"width":140,"height":74},
		{"id":"1719c1fef43b7494","type":"text","text":"時雄、ときめく","x":-13,"y":-300,"width":171,"height":60,"color":"#f078f0"},
		{"id":"354381f542d6452b","type":"text","text":"1903年、美知代、花袋に書簡を送り入門を懇願","x":-512,"y":-447,"width":191,"height":148},
		{"id":"2f64656644007d34","type":"text","text":"1909年、美知代、\n永代と結婚","x":-591,"y":2389,"width":200,"height":80},
		{"id":"d47e42bd0179e481","type":"text","text":"5日後、芳子から候文の手紙が届く。","x":-215,"y":2019,"width":220,"height":80,"color":"5"},
		{"id":"776b0260257d7480","type":"text","text":"時雄、芳子の蒲団に包まり夜着の匂いを嗅いで泣く","x":-155,"y":2164,"width":240,"height":100,"color":"#f078f0"},
		{"id":"a643c66d3a9bd730","type":"text","text":"芳子、帰郷することになる。","x":-239,"y":1521,"width":220,"height":80,"color":"5"},
		{"id":"4d858c2521337485","type":"text","text":"田中、芳子の帰郷をそっと見送りに来る。\n芳子、胸を轟かせる。\n時雄、田中に気が付かない","x":-244,"y":1797,"width":240,"height":158,"color":"5"},
		{"id":"49cecee248bdfd61","type":"text","text":"時雄、芳子の帰郷を見送る。","x":-256,"y":1651,"width":187,"height":80,"color":"5"},
		{"id":"92c14f1bee9afb17","type":"text","text":"芳子と田中の親密な関係が明らかになる","x":-239,"y":1361,"width":200,"height":100,"color":"5"},
		{"id":"cd7f00dd1e7cebb1","type":"text","text":"芳子の父が上京する。","x":-263,"y":1249,"width":210,"height":60,"color":"5"},
		{"id":"6c25720d5e231a1c","type":"text","text":"父／モーパッサン\n時雄、作中の若い女性が泣く場面を思い出す","x":73,"y":1392,"width":317,"height":128,"color":"3"},
		{"id":"a5b819d2a839a68b","type":"text","text":"時雄、激しく煩悶","x":-17,"y":1266,"width":178,"height":80,"color":"#f078f0"},
		{"id":"be37246cdef3b294","type":"text","text":"プニンとバブリン／ツルゲーネフ\n時雄、芳子と結ばれる「別の人生」を空想する","x":93,"y":1725,"width":297,"height":135,"color":"3"},
		{"id":"c88e82fa638a66db","type":"text","text":"時雄、あきらめきれない","x":-18,"y":1616,"width":178,"height":80,"color":"#f078f0"},
		{"id":"d127b2a18f43d2a7","type":"text","text":"1895年、信子、国木田独歩と結婚","x":-687,"y":-497,"width":161,"height":127},
		{"id":"818205a743385bb0","type":"text","text":"1919年、有島武郎、「或る女」を発表","x":-664,"y":2535,"width":312,"height":80},
		{"id":"a424eaa0de7fd493","type":"text","text":"1908年4月\n美知代、『侮辱』を発表。\n天賞を受賞","x":-656,"y":2072,"width":240,"height":160},
		{"id":"34b037cca8eec943","type":"text","text":"1907年9月\n花袋、『蒲団』を発表。\n美知代、スキャンダルに巻き込まれる。","x":-650,"y":1820,"width":240,"height":160},
		{"id":"0390de8b01d35d2d","type":"text","text":"『蒲団』の発表以前に美知代は永代との恋愛について作品化。花袋はその作品に目を通している。","x":-657,"y":1560,"width":260,"height":160},
		{"id":"af439fbd8010d62b","type":"text","text":"独歩と花袋は友人関係","x":-684,"y":-121,"width":130,"height":107},
		{"id":"6004a1c91b85dec0","type":"text","text":"1906年10月、花袋、美知代の故郷・上下町に2日滞在。","x":-660,"y":1324,"width":260,"height":100},
		{"id":"7dcbfdcdf3a80e3f","type":"text","text":"ファースト／ツルゲーネフ\n芳子の感情が目覚める。","x":97,"y":-83,"width":278,"height":110,"color":"3"},
		{"id":"6f75125391c30e41","type":"text","text":"人形の家／イプセン\nノラの話","x":100,"y":46,"width":274,"height":97,"color":"3"},
		{"id":"3d5adbc783bfafd4","type":"text","text":"故郷（マグダ）／ズーダーマン\n芳子の自由・自立心が芽生える","x":110,"y":174,"width":279,"height":107,"color":"3"},
		{"id":"4b52cd2b9095664d","type":"text","text":"信子、有島武郎「或る女」の主人公 葉子のモデルとなる。\n又、木部という登場人物は、独歩がモデルである。","x":88,"y":2435,"width":291,"height":192},
		{"id":"56d171ff9f992c21","type":"text","text":"寂しき人々／ハウプトマン\n芳子の登場で孤独が破られる。","x":87,"y":-593,"width":299,"height":110,"color":"3"},
		{"id":"0ad91a2123a151de","type":"text","text":"魔風恋風／小杉天外\n金色夜叉／尾崎紅葉\n禁読対象となった作品","x":130,"y":-784,"width":210,"height":118,"color":"#e3e3e3"}
	],
